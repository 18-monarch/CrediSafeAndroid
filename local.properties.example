# Android Studio normally writes sdk.dir automatically.
# sdk.dir=C:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk

# Public CrediSafe API URLs. No map key is required. Never put DATABASE_URL,
# JWT_SECRET, or Valhalla infrastructure credentials in this Android file.
CREDISAFE_API_DEBUG_URL=https://credisafeandroid.onrender.com/v1/
CREDISAFE_API_RELEASE_URL=https://credisafeandroid.onrender.com/v1/

# Optional local overrides:
# CREDISAFE_VERSION_CODE=25
# CREDISAFE_VERSION_NAME=2.7.0-beta.1
