# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=

# OSM/Valhalla road matching. Public endpoint is fair-use beta only; use a
# CrediSafe-controlled deployment before production scale.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
VALHALLA_CLIENT_ID=CrediSafe-Open-Mobility/2.7

# Controlled pilot opt-in. When true, the backend STILL accepts only mapped
# OSM-tagged limits (edge.speed_type=tagged + edge.speed_limit), accurate GPS
# <=20 m and a road match <=15 m. Classified routing speed is NEVER a limit.
# Tagged data may be outdated; these are research estimates, NOT legal evidence.
# Keep false outside a monitored, consented pilot.
VALHALLA_SPEED_LIMITS_TRUSTED=false

# Optional independent HMAC key for signed road-limit evidence. Defaults to
# existing JWT_SECRET if unset. Never expose the value to the Android app.
ROAD_LIMIT_PROOF_SECRET=
