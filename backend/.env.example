DATABASE_URL=
PORT=3000

# Optional: configure for authenticated session signing in production.
JWT_SECRET=

# Server-side Google Maps Platform key. Enable Roads API + Geocoding API.
# Never put this server key in the Android APK.
GOOGLE_MAPS_SERVER_API_KEY=

# Roads Speed Limits has restricted licensing/access. Keep false unless your
# Google Maps Platform project has the required entitlement.
GOOGLE_ROADS_SPEED_LIMITS_ENABLED=false
