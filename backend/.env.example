# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=

# OSM/Valhalla road matching. Public endpoint is fair-use beta only; use a
# CrediSafe-controlled deployment before production scale.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
VALHALLA_CLIENT_ID=CrediSafe-Open-Mobility/2.7

# Keep false unless the selected Valhalla graph is verified to expose posted,
# legally trustworthy limits rather than inferred/default speeds.
VALHALLA_SPEED_LIMITS_TRUSTED=false
